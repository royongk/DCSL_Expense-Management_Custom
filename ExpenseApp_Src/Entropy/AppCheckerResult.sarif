      "tool": {
        "driver": {
          "fullName": "PowerApps app checker",
          "name": "PowerApps app checker",
          "rules": [
            {
              "id": "app-SuggestRemoteExecutionHint",
              "messageStrings": {
                "issue": {
                  "text": "Delegation warning. The \"{0}\" part of this formula might not work correctly on large data sets."
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "If your data set exceeds the 500 record limit but contains less than 2,000 records, try resetting the limit.",
                  "Try simplifying the formula.",
                  "Try moving your data to a different data source."
                ],
                "level": "Medium",
                "primaryCategory": "formula",
                "whyFix": ""
              }
            },
            {
              "id": "app-ErrBadType-ExpectedTypesCSV",
              "messageStrings": {
                "issue": {
                  "text": "Invalid argument type. Expecting one of the following: {0}."
                }
              },
              "properties": {
                "componentType": "app",
                "level": "High",
                "primaryCategory": "formula",
                "whyFix": ""
              }
            },
            {
              "id": "app-ErrBadType-ExpectedType-ProvidedType",
              "messageStrings": {
                "issue": {
                  "text": "Invalid argument type ({1}). Expecting a {0} value instead."
                }
              },
              "properties": {
                "componentType": "app",
                "level": "High",
                "primaryCategory": "formula",
                "whyFix": ""
              }
            },
            {
              "id": "app-ErrBadType-Type",
              "messageStrings": {
                "issue": {
                  "text": "Invalid argument type. Cannot use {0} values in this context."
                }
              },
              "properties": {
                "componentType": "app",
                "level": "Medium",
                "primaryCategory": "formula",
                "whyFix": ""
              }
            },
            {
              "id": "app-ErrColumnDoesNotExist-Name-Similar",
              "messageStrings": {
                "issue": {
                  "text": "The specified column '{0}' does not exist. The column with the most similar name is '{1}'."
                }
              },
              "properties": {
                "componentType": "app",
                "level": "High",
                "primaryCategory": "formula",
                "whyFix": ""
              }
            },
            {
              "id": "app-ErrInvalidArgs-Func",
              "messageStrings": {
                "issue": {
                  "text": "The function '{0}' has some invalid arguments."
                }
              },
              "properties": {
                "componentType": "app",
                "level": "High",
                "primaryCategory": "formula",
                "whyFix": ""
              }
            },
            {
              "id": "app-ErrInvalidName",
              "messageStrings": {
                "issue": {
                  "text": "Name isn't valid. '{0}' isn't recognized."
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Remove or correct the reference to the name that isn't valid."
                ],
                "level": "High",
                "primaryCategory": "formula",
                "whyFix": ""
              }
            },
            {
              "id": "app-ErrIncompatibleCtxtVariableTypes",
              "messageStrings": {
                "issue": {
                  "text": "Incompatible type. We can't evaluate your formula because the context variable types are incompatible with the types of values in other places in your app."
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Look at places where you use a context variable and make sure that the type (e.g., text, number, date, record, table) is compatible."
                ],
                "level": "High",
                "primaryCategory": "formula",
                "whyFix": ""
              }
            },
            {
              "id": "app-ErrIncompatibleTypesForEquality-Left-Right",
              "messageStrings": {
                "issue": {
                  "text": "Incompatible types for comparison. These types can't be compared: {0}, {1}."
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "You might need to convert the value to be the same type, such as converting a date string (e.g., \"12/31/2018\") to a date value.",
                  "If you're comparing records or tables, the field or column types must match exactly."
                ],
                "level": "High",
                "primaryCategory": "formula",
                "whyFix": ""
              }
            },
            {
              "id": "app-WarnInvalidTypeForVariableDefinition",
              "messageStrings": {
                "issue": {
                  "text": "The variable {0} needs to have a non-Blank type. If this is the only place that {0} is defined, resolve this by adding another definition elsewhere that assigns a non-Blank value to this variable."
                }
              },
              "properties": {
                "componentType": "app",
                "level": "Medium",
                "primaryCategory": "formula",
                "whyFix": ""
              }
            },
            {
              "id": "app-ErrTypeError-Arg-Expected-Found",
              "messageStrings": {
                "issue": {
                  "text": "The type of this argument '{0}' does not match the expected type '{1}'. Found type '{2}'."
                }
              },
              "properties": {
                "componentType": "app",
                "level": "High",
                "primaryCategory": "formula",
                "whyFix": ""
              }
            },
            {
              "id": "app-ErrUnknownNamespaceFunction",
              "messageStrings": {
                "issue": {
                  "text": "'{0}' is an unknown or unsupported function in namespace '{1}'."
                }
              },
              "properties": {
                "componentType": "app",
                "level": "High",
                "primaryCategory": "formula",
                "whyFix": ""
              }
            },
            {
              "id": "app-ErrInvalidDot",
              "messageStrings": {
                "issue": {
                  "text": "The '.' operator cannot be used on {0} values."
                }
              },
              "properties": {
                "componentType": "app",
                "level": "High",
                "primaryCategory": "formula",
                "whyFix": ""
              }
            },
            {
              "id": "app-ErrBadType-NonBehavioralVoidExpression",
              "messageStrings": {
                "issue": {
                  "text": "Argument type mismatch. The types of all result arguments must agree with or be coercible to the first result argument."
                }
              },
              "properties": {
                "componentType": "app",
                "level": "High",
                "primaryCategory": "formula",
                "whyFix": ""
              }
            },
            {
              "id": "app-ErrColumnTypeMismatch-ColName-ExpectedType-ActualType",
              "messageStrings": {
                "issue": {
                  "text": "Incompatible type. The '{0}' column in the data source you're updating expects a '{1}' type and you're using a '{2}' type."
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "You might need to convert the value to the same type, such as converting a date string (e.g., \"12/31/2018\") to a date value or a string to a number."
                ],
                "level": "High",
                "primaryCategory": "formula",
                "whyFix": ""
              }
            },
            {
              "id": "app-WrnCountRowsMayReturnCachedValue",
              "messageStrings": {
                "issue": {
                  "text": "CountRows may return a cached value. Use CountIf(DataSource, true) to get the latest count."
                }
              },
              "properties": {
                "componentType": "app",
                "level": "Medium",
                "primaryCategory": "formula",
                "whyFix": ""
              }
            },
            {
              "id": "acc-AccessibleLabelNeeded",
              "messageStrings": {
                "issue": {
                  "text": "Missing accessible label"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Edit the accessible label property to describe the item."
                ],
                "level": "Medium",
                "primaryCategory": "accessibility",
                "whyFix": "If there's no accessible text, people who can’t see the screen won't understand what’s in images and controls."
              }
            },
            {
              "id": "acc-TabIndexShouldBeDefinedForInteractiveControl",
              "messageStrings": {
                "issue": {
                  "text": "Missing tab stop"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Set TabIndex to 0 or greater to ensure that interactive elements have a tab stop."
                ],
                "level": "Medium",
                "primaryCategory": "accessibility",
                "whyFix": "People who use the keyboard with your app will not be able to access this element without a tab stop."
              }
            },
            {
              "id": "acc-FocusBorderShouldBeVisible",
              "messageStrings": {
                "issue": {
                  "text": "Focus isn't showing"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Change the FocusedBorderThickness property to be more than 0."
                ],
                "level": "Medium",
                "primaryCategory": "accessibility",
                "whyFix": "If the focus isn't visible, people who don't use a mouse won't be able to see it when they're interacting with the app."
              }
            },
            {
              "id": "acc-HelpfulControlSettingNeeded",
              "messageStrings": {
                "issue": {
                  "text": "Missing helpful control settings"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Select the warning and set the item property to true to enable control setting."
                ],
                "level": "Medium",
                "primaryCategory": "accessibility",
                "whyFix": "Changing this property setting will give the user better information about the function of the controls in your app."
              }
            },
            {
              "id": "acc-StateIndicationTextNeeded",
              "messageStrings": {
                "issue": {
                  "text": "Add State indication text"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Set ShowValue = true to show the current state of the control."
                ],
                "level": "Low",
                "primaryCategory": "accessibility",
                "whyFix": "Users won't get confirmation of their actions if the state of the control isn't showing."
              }
            },
            {
              "id": "acc-CaptionsNeeded",
              "messageStrings": {
                "issue": {
                  "text": "Missing captions"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Use the ClosedCaptionsURL property to add the URL for captions."
                ],
                "level": "Medium",
                "primaryCategory": "accessibility",
                "whyFix": "Without captions, people with disabilities may not get any of the information in a video or audio segment."
              }
            },
            {
              "id": "app-UnusedVariables",
              "messageStrings": {
                "issue": {
                  "text": "사용되지 않은 변수"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "사용하지 않는 변수를 제거합니다."
                ],
                "level": "Medium",
                "primaryCategory": "performance",
                "whyFix": "이 변수는 선언되었지만 컨트롤에서 참조되지 않으므로, 필요하지 않습니다."
              }
            },
            {
              "id": "app-UnusedMediaResources",
              "messageStrings": {
                "issue": {
                  "text": "사용하지 않는 미디어 파일"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "[미디어] 창에서 사용되지 않는 미디어 파일을 제거합니다."
                ],
                "level": "Medium",
                "primaryCategory": "performance",
                "whyFix": "이 미디어 파일은 어떤 컨트롤 수식에서도 참조되지 않으므로 필요하지 않습니다. 이 파일을 제거하면 성능이 개선됩니다."
              }
            },
            {
              "id": "app-CollectDelegatableDataSource",
              "messageStrings": {
                "issue": {
                  "text": "데이터 원본에서 검색한 행이 완료되지 않을 수 있습니다."
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "'Filter' 또는 'Search' 같은 필터링 함수를 포함하도록 \"ClearCollect(colCurrencies, 'Currencies (mserp)')\" 수식을 업데이트하여 데이터 원본에서 수집되는 데이터를 제한합니다."
                ],
                "level": "Medium",
                "primaryCategory": "performance",
                "whyFix": "'Collect' 함수를 사용하여 연결된 데이터 원본에서 직접 컬렉션을 만들면 데이터 원본이 너무 큰 경우 일부 행이 로드되지 않을 수 있습니다."
              }
            },
            {
              "id": "app-DataSourceDefaultMaxRowsLimit",
              "messageStrings": {
                "issue": {
                  "text": "위임할 수 없는 쿼리에 대한 데이터 행 제한이 500개 이상입니다."
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "고급 앱 설정에서 '위임할 수 없는 쿼리에 대한 데이터 행 제한'을 업데이트하세요."
                ],
                "level": "Medium",
                "primaryCategory": "performance",
                "whyFix": "'데이터 행 제한'을 500개 이상으로 설정하면, 서버에서 쿼리를 실행하는 대신 앱에서 모든 행을 스스로 처리해야 하므로, 위임할 수 없는 쿼리를 실행할 때 앱이 느려질 수 있습니다. "
              }
            },
            {
              "id": "app-CrossScreenEventDependencies",
              "messageStrings": {
                "issue": {
                  "text": "이벤트 규칙이 다른 화면에서 컨트롤을 참조합니다."
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "작업을 소유 화면(예: Screen.OnVisible)의 이벤트로 이동하거나 Navigate의 컨텍스트 매개 변수 또는 전역 변수를 사용하여 화면 간에 상태를 전달하고 대상 화면에서 해당 작업에 반응합니다."
                ],
                "level": "Medium",
                "primaryCategory": "performance",
                "whyFix": "다른 화면에서 컨트롤을 참조하는 이벤트 규칙(예: OnStart, OnVisible 및 OnSelect)은 사용자가 탐색하지 않더라도 해당 화면을 로드하고 초기화하도록 강제합니다. 이로 인해 앱 시작 및 탐색 속도가 크게 느려질 수 있습니다."
              }
            },
            {
              "id": "app-ForAllWithMutation",
              "messageStrings": {
                "issue": {
                  "text": "ForAll 내에서 컬렉션 또는 데이터 원본을 변경하면 과도한 규칙 다시 평가가 트리거될 수 있습니다."
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "ForAll은 테이블을 반환하므로 단일 일괄 처리 호출에서 변경 함수에 입력으로 결과를 전달합니다. 예를 들어 ForAll(source, Collect(c, { ... }))을 Collect(c, ForAll(source, { ... }))로 바꾸세요. Patch 및 Remove에 동일한 패턴이 적용됩니다. 단일 배치 뮤테이션은 반복마다 알림을 보내는 대신 한 번의 변경 알림만 발생시킵니다.",
                  "데이터 원본에 대한 간단한 행별 업데이트 또는 삭제의 경우 ForAll을 반복하는 대신 ForAll 외부에서 한 번 호출되는 위임 가능한 UpdateIf 또는 RemoveIf 함수를 선호합니다."
                ],
                "level": "Medium",
                "primaryCategory": "performance",
                "whyFix": "ForAll 본문 내에서 Collect, Patch, Remove 또는 다른 변경 함수를 사용하면 반복당 한 번씩 대상 컬렉션 또는 데이터 원본이 변경됩니다. 해당 컬렉션 또는 데이터 원본에 종속된 모든 컨트롤 속성은 각 변경에 대해 다시 평가되며, 작은 루프를 수천 개의 규칙 평가로 변환하고 연결된 데이터 원본의 경우 행당 네트워크 요청을 수행할 수 있습니다."
              }
            },
            {
              "id": "app-CollectingReadOnlyTable",
              "messageStrings": {
                "issue": {
                  "text": "컬렉션이 초기화되었지만 업데이트되지 않음"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Collect 또는 ClearCollect를 App.Formulas의 명명된 수식으로 바꿉니다. 예를 들어 MyTable = Filter(source, condition)입니다. 명명된 수식은 입력이 변경될 때 계산되며 컬렉션의 추적 비용을 전달하지 않습니다."
                ],
                "level": "Medium",
                "primaryCategory": "performance",
                "whyFix": "컬렉션은 업데이트됩니다. Power Apps 데이터가 변경되면 모든 컬렉션이 동기화된 상태로 유지되도록 모든 컬렉션을 추적하기 위해 추가 작업을 수행합니다. 데이터가 설정된 후 변경되지 않으면 추적 작업이 낭비됩니다. 명명된 수식은 추가 비용 없이 동일한 데이터를 제공합니다."
              }
            },
            {
              "id": "app-InefficientDelayLoading",
              "messageStrings": {
                "issue": {
                  "text": "비효율적인 지연 로드"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "대신 변수, 컬렉션 및 탐색 컨텍스트를 사용하여 화면 전체에서 상태를 공유합니다."
                ],
                "level": "Medium",
                "primaryCategory": "performance",
                "whyFix": "다른 화면의 컨트롤을 참조하는 컨트롤은 앱 로딩 및 탐색 속도를 느리게 만들 수 있습니다. 그러면 사용자가 해당 화면으로 이동할 때까지 기다리지 않고 앱이 즉시 다른 화면을 로드할 수 있습니다."
              }
            },
            {
              "id": "app-CountRowsGalleryAllItems",
              "messageStrings": {
                "issue": {
                  "text": "AllItems와 함께 CountRows 대신 AllItemsCount 사용"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "성능 향상을 위해 CountRows(Gallery.AllItems)를 Gallery.AllItemsCount로 대체합니다."
                ],
                "level": "Medium",
                "primaryCategory": "performance",
                "whyFix": "갤러리의 AllItems 속성과 함께 CountRows를 사용하면 입력 데이터 원본의 복사본과 모든 자식 컨트롤의 현재 상태가 포함된 출력 테이블이 생성됩니다. 이로 인해 초기화되지 않은 행이 초기화되고 추가 CPU 주기, 메모리 및 잠재적으로 행 수준 네트워크 요청이 트리거될 수 있습니다."
              }
            },
            {
              "id": "app-ScreenHasManyControls",
              "messageStrings": {
                "issue": {
                  "text": "화면에 컨트롤이 너무 많습니다."
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "화면에서 컨트롤 수를 줄입니다.",
                  "앱을 더 많은 화면으로 분할하여 화면 복잡성을 줄입니다.",
                  "구성 요소를 사용하여 화면에서 동일하게 그룹화된 컨트롤을 통합하여 중복을 줄입니다.",
                  "갤러리를 사용하여 일련의 반복되는 비슷한 컨트롤을 나타냅니다.",
                  "각 앱이 작고 성능이 유지되도록 앱을 여러 앱으로 분할합니다."
                ],
                "level": "Medium",
                "primaryCategory": "performance",
                "whyFix": "화면에 컨트롤이 너무 많으면 각 컨트롤에서 리소스를 사용하고 앱이 느려지거나 응답하지 않을 수 있습니다. \"Itemization - Itemized Expense Edit Screen\"의 예상 복잡성은 307이며, 이는 권장되는 최대 임계값(300)을 초과합니다."
              }
            },
            {
              "id": "app-IndexedAccessViaCopy",
              "messageStrings": {
                "issue": {
                  "text": "Index를 사용하여 지정된 위치에서 레코드 읽기"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "Last(FirstN(t, n))를 Index(t, Min(CountRows(t), n))로 바꿉니다. t와 n은 원래 식과 동일하게 유지됩니다. Min은 원래 동작을 유지합니다. n이 범위에 있으면 n번째 행을 반환하고 n이 행 개수보다 크면 오류 대신 마지막 행을 반환합니다. n이 1과 CountRows(t) 사이임을 이미 알고 있는 경우 Index(t, n)로 단순화할 수 있습니다.",
                  "First(LastN(t, n))를 Index(t, Max(1, CountRows(t) - n + 1))로 바꿉니다. t와 n은 원래 식과 동일하게 유지됩니다. Max는 원래 동작을 유지합니다. n이 범위 안에 있으면 n-th-from-end 행을 반환하고, n이 행 개수보다 크면 오류 대신 첫 번째 행을 반환합니다. n이 1과 CountRows(t) 사이임을 이미 알고 있는 경우 Index(t, CountRows(t) - n + 1)로 단순화할 수 있습니다."
                ],
                "level": "Medium",
                "primaryCategory": "performance",
                "whyFix": "Last(FirstN(t, n)) 및 First(LastN(t, n))와 같은 식에서 t는 테이블이고 n은 행 위치입니다. 두 폼 모두 경계에서 하나의 레코드를 반환하기 위해 테이블 복사본을 최대 n개의 행으로 구체화합니다. Index(t, ...)는 중간 복사본을 빌드하지 않고 직접 위치에 레코드를 반환하므로 복사 비용과 복사가 트리거하는 행당 작업을 방지할 수 있습니다. n이 1에서 t의 행 수 사이인 경우(식별자 t와 n은 원래 식과 동일하게 유지되어야 함) 두 폼은 동일한 레코드를 반환합니다. n이 행 개수 Index 오류를 초과하면 FirstN/LastN 양식이 경계 행에 고정되므로 데이터가 n보다 작을 수 있는 경우 Min(CountRows(t), n)과 같은 클램핑 수식을 사용합니다."
              }
            },
            {
              "id": "app-NumericPropertySizeWarning",
              "messageStrings": {
                "issue": {
                  "text": "최대 10MB까지 큰 파일을 업로드할 수 있도록 허용"
                }
              },
              "properties": {
                "componentType": "app",
                "howToFix": [
                  "이 크기의 첨부 파일이 필요한지 여부를 고려합니다."
                ],
                "level": "Low",
                "primaryCategory": "performance",
                "whyFix": "지원되는 모든 플랫폼에서 테스트하여 이 크기의 첨부 파일을 업로드할 수 있는지 확인하는 것이 좋습니다."
              }
            }
          ],
          "version": "1.349"
        }
      }
    }
  ],
  "version": "2.1.0"
